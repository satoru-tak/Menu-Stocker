# Root level
.DS_Store
.env*
!.env.example

# Backend (Rails)
/backend/.bundle
/backend/log/*
!/backend/log/.keep
/backend/tmp/*
!/backend/tmp/.keep
/backend/tmp/pids/*
!/backend/tmp/pids/
!/backend/tmp/pids/.keep
/backend/storage/*
!/backend/storage/.keep
/backend/tmp/storage/*
!/backend/tmp/storage/
!/backend/tmp/storage/.keep
/backend/config/master.key
/backend/.env*
!/backend/.env*.erb

# Frontend (Next.js)
/frontend/node_modules
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions
/frontend/coverage
/frontend/.next/
/frontend/out/
/frontend/build
/frontend/*.pem
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/.pnpm-debug.log*
/frontend/.env*
/frontend/.vercel
/frontend/*.tsbuildinfo
/frontend/next-env.d.ts

# Docker
/db/psql/*
!/db/psql/.keep

# Editor directories and files
.idea
.vscode
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?